# ===========================================================================
# Spark — miljövariabler
#
# Kopiera till .env.local för lokal utveckling, och lägg in samma variabler
# under Settings → Environment Variables i Vercel för produktion.
#
# Sidan startar utan de flesta av dem: utan databas sparas ingen anmälan
# (och det syns i loggen), utan mejlnycklar skrivs mejlet ut i konsolen i
# stället för att skickas. Inget låtsas ha fungerat.
# ===========================================================================

# --- Publik adress ---------------------------------------------------------
# Utan avslutande snedstreck. Används för canonical, sitemap, OG-taggar och
# för länkarna i mejlen — sätts den fel pekar avregistreringslänken fel.
NEXT_PUBLIC_SITE_URL=https://spark.se

# --- Supabase --------------------------------------------------------------
# URL och anon-nyckeln finns under Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role-nyckeln, samma sida. Den går förbi row level security och är
# det enda som kommer åt signups-tabellen. Får ALDRIG ha prefixet
# NEXT_PUBLIC_ och aldrig checkas in.
SUPABASE_SERVICE_ROLE_KEY=

# --- Signering -------------------------------------------------------------
# Signerar avregistrerings- och raderingslänkar och hashar IP-adresser för
# rate limiting. Minst 32 slumpade tecken:
#   openssl rand -base64 48
# Byter du den slutar redan utskickade länkar att fungera.
TOKEN_SECRET=

# --- Mejl ------------------------------------------------------------------
# brevo är det enda värdet i dag. Byt hit när SES finns.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
# Avsändaren måste vara en verifierad avsändare i Brevo, annars refuseras
# utskicket eller hamnar i skräpposten.
EMAIL_FROM=hej@spark.se
EMAIL_FROM_NAME=Spark
# Brevos gratisnivå: 300 mejl per dygn. Kön skickar högst så många per körning.
EMAIL_DAILY_QUOTA=300

# Dit den dagliga backupen skickas, och adressen som står i integritetspolicyn.
ADMIN_EMAIL=

# --- Admin -----------------------------------------------------------------
# HTTP Basic Auth för /admin och /api/admin. Inget NEXT_PUBLIC_-prefix, så
# värdena kan inte hamna i klientbundeln.
ADMIN_USER=
ADMIN_PASSWORD=

# --- Cron ------------------------------------------------------------------
# Krävs i x-cron-secret (eller Authorization: Bearer) på /api/cron. Utan den
# svarar routen 401. Vercel Cron skickar automatiskt Bearer-varianten om du
# lägger samma värde i CRON_SECRET.
#   openssl rand -base64 32
CRON_SECRET=

# --- Analytics (valfritt) --------------------------------------------------
# Umami, självhostad. Cookiefri, så ingen cookiebanner behövs. Båda måste
# vara satta, annars laddas skriptet inte alls.
NEXT_PUBLIC_UMAMI_SRC=https://analytics.spark.se/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- Produktappen (valfritt) ----------------------------------------------
# Bara för /dashboard-delen, inte för coming soon-sidan.
ANTHROPIC_API_KEY=
